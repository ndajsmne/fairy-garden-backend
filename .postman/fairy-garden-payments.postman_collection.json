{
  "info": {
    "name": "Fairy Garden - Payments",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Initiate Payment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/orders/{{orderId}}/pay",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders",
            "{{orderId}}",
            "pay"
          ]
        }
      }
    },
    {
      "name": "Payment Notification (simulate gateway)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"order_id\": \"ORDER-{{orderId}}\",\n  \"transaction_status\": \"settlement\",\n  \"transaction_id\": \"TRANS-12345\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/payments/payment-notification",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "payments",
            "payment-notification"
          ]
        }
      }
    },
    {
      "name": "Get Payment Status",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/orders/{{orderId}}/payment-status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders",
            "{{orderId}}",
            "payment-status"
          ]
        }
      }
    }
  ],
  "event": [],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "jwt_token",
      "value": ""
    },
    {
      "key": "orderId",
      "value": "1"
    }
  ]
}
